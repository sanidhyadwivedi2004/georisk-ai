# GeoRisk AI Environment Variables Example
# IMPORTANT: Do NOT put real secrets, tokens, or API keys in this file.
# Copy this file to '.env' and fill in your actual values there.
# Secrets in '.env' are ignored by Git and must never be committed.

# Database Configuration (PostgreSQL / PostGIS / pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/georisk_db

# External Data APIs
EIA_API_KEY=
GDELT_BASE_URL=https://blog.gdeltproject.org/
UN_COMTRADE_API_KEY=

# Local AI / LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
