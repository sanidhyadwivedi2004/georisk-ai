# GeoRisk AI Environment Variables Example
# Copy this file to '.env' and fill in your actual environment values.

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
DEMO_MODE=true
SECRET_KEY=georisk-ai-secret-key-change-in-production

# Database Configuration (Supabase PostgreSQL / PostGIS or SQLite fallback)
DATABASE_URL=sqlite:///./georisk.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider Configuration ("deepseek", "gemini", "ollama", or "auto")
LLM_PROVIDER=auto

# AI API Keys
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# External Data APIs
NEWS_API_KEY=
EIA_API_KEY=
UN_COMTRADE_API_KEY=
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
