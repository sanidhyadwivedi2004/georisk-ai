# GeoRisk AI Backend Environment Variables Example
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
DEMO_MODE=true
SECRET_KEY=georisk-ai-backend-secret-key-change-in-production

# Supabase PostgreSQL / PostGIS Database (or local SQLite fallback)
DATABASE_URL=sqlite:///./georisk.db
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Provider Configuration ("deepseek", "gemini", "ollama", or "auto")
LLM_PROVIDER=auto

# AI API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=

# External Data APIs
NEWS_API_KEY=
EIA_API_KEY=
UN_COMTRADE_API_KEY=
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
